# Flask Application Environment
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-32-char-key-in-production

# Server Host and Port
HOST=127.0.0.1
PORT=5000

# Logging & Operational Configuration
LOG_LEVEL=INFO
ACTIVE_MODEL=mobilenet

# Optional C2PA signer trust list (PEM). Without it, C2PA claims do not bypass the model.
C2PA_TRUST_ANCHORS_PATH=/home/salman/Downloads/anchors.pem
